# Yarn files
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*

# Node dependencies
node_modules/
web/node_modules/
mobile/node_modules/
server/node_modules/
features/node_modules/

# Lock files
yarn.lock
web/yarn.lock
mobile/yarn.lock
server/yarn.lock
features/yarn.lock
package-lock.json
web/package-lock.json
mobile/package-lock.json
server/package-lock.json
features/package-lock.json

# Build output
dist/
web/dist/
server/dist/
features/dist/

# Expo specific files (for mobile)
.expo/
mobile/.expo/
web-build/
mobile/web-build/
expo-env.d.ts
mobile/expo-env.d.ts

# Expo shared assets
mobile/expo-shared/

# Android build files (for mobile)
mobile/android/
mobile/*.apk
mobile/*.aab

# iOS build files (for mobile)
mobile/ios/
mobile/*.ipa

# Native files
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro cache (for React Native)
.metro-health-check*

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS files
.DS_Store
*.pem

# Environment files
.env*.local
web/.env*.local
mobile/.env*.local
server/.env*.local
features/.env*.local

# TypeScript build info
*.tsbuildinfo
web/*.tsbuildinfo
mobile/*.tsbuildinfo
server/*.tsbuildinfo
features/*.tsbuildinfo

# Vite-specific files (for web and features)
web/.vite/
features/.vite/