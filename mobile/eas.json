        "EXPO_APP_ENV": "production",
        "EXPO_PUBLIC_PRODUCT_NAME": "veriqr",
        "EXPO_PUBLIC_SERVER_BASE_URL": "http://localhost:5000/",
        "EXPO_PUBLIC_CDN_BUCKET_PUBLIC_ASSETS_BASE_URL": "https://cdn.veriqr.com/",
